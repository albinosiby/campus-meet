rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidRegistrationCreate() {
      return request.resource.data.keys().hasAll([
          'fullName', 'email', 'phone', 'gender', 'college', 'course',
          'year', 'zone', 'diocese', 'dietary', 'amount',
          'transactionId', 'paymentStatus', 'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() >= 8
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 950
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.gender in ['male', 'female']
        && request.resource.data.year in ['1', '2', '3', '4', '5', 'pg']
        && request.resource.data.zone in ['kannur', 'kasargod', 'thalassery', 'kozhikode', 'mananthavady']
        && request.resource.data.dietary in ['none', 'veg', 'nonveg'];
    }

    function isAdminPaymentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentStatus', 'amount', 'transactionId'])
        && request.resource.data.paymentStatus in ['paid', 'unpaid', 'pending']
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.transactionId is string;
    }

    function isPublicPaymentSubmit() {
      return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentStatus', 'transactionId', 'amount'])
        && resource.data.paymentStatus in ['unpaid', 'pending']
        && resource.data.paymentStatus != 'paid'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() >= 8
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
    }

    match /registrations/{registrationId} {
      allow create: if isValidRegistrationCreate();
      allow read: if true;
      allow update: if isAdminPaymentUpdate() || isPublicPaymentSubmit();
      allow delete: if true;
    }
  }
}
